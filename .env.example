# Copy this file to .env, then fill in only the services you will use.
# An OpenAI-compatible chat completions endpoint. NVIDIA NIM is the default.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-8b-instruct
# Optional: with the OpenRouter endpoint, try this model if the primary is unavailable.
LLM_FALLBACK_MODEL=
WIKIMEDIA_USER_AGENT=ShortsPublisher/0.1 (replace with your contact email or project URL)

# Automatic stock video search. Configure either source or both.
# Pexels has paused new API key issuance; existing keys still work.
PEXELS_API_KEY=
# Sign in at https://pixabay.com/api/docs/ to see your Pixabay API key.
PIXABAY_API_KEY=
# Create narration-based explainer cards when no relevant clip is found.
STOCK_FALLBACK=concept
# Image-capable chat model used to inspect candidate video frames. Defaults to LLM_MODEL.
STOCK_VISION_MODEL=
MAX_VIDEO_DOWNLOAD_BYTES=50000000

# Local paths are anchored to this project directory.
DATABASE_PATH=work/jobs.sqlite3
WORK_DIR=work
SECRETS_DIR=.secrets
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=30
VIDEO_CRF=21
FFMPEG_PRESET=fast

# YouTube Desktop OAuth: place the client JSON file at the path below, then run auth-youtube.
YOUTUBE_CLIENT_SECRET_FILE=.secrets/client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube-token.json

# Meta Page and a professional Instagram account linked to that Page.
META_GRAPH_VERSION=v24.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

HTTP_TIMEOUT_SECONDS=30
RETRY_LIMIT=3
WEBHOOK_URL=

